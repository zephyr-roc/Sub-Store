{
  "name": "sub-store-cloudflare-adapter",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Workers adapter for the upstream Sub-Store backend in this repository",
  "scripts": {
    "prepare:wasm": "node scripts/prepare-wasm.cjs",
    "build": "npm run prepare:wasm && node esbuild.js",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "check": "npm run build && wrangler deploy --dry-run --outdir dist/check"
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "quickjs-emscripten": "^0.32.0",
    "age-encryption": "^0.3.0",
    "buffer": "^6.0.3",
    "dns-packet": "^5.6.1",
    "ip-address": "^10.7.5",
    "js-base64": "^3.7.2",
    "json5": "^2.2.3",
    "jsrsasign": "^11.1.0",
    "lodash": "^4.17.21",
    "ms": "^2.1.3",
    "nanoid": "^3.3.20",
    "peggy": "^2.0.1",
    "semver": "^7.8.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "wrangler": "^4.129.0"
  }
}
